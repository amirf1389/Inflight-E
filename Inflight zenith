        // ----------------------------------------------------
        // 9. YOUTUBE APP EMBED
        // ----------------------------------------------------
        function openYouTubeApp() { document.getElementById('youtube-app-modal').classList.remove('hidden-page'); }
        function closeYouTubeApp() {
            document.getElementById('youtube-app-modal').classList.add('hidden-page');
            const frame = document.getElementById('yt-player-frame');
            frame.src = frame.src;
        }

        function changeYouTubeVideo(videoId, title) {
            const frame = document.getElementById('yt-player-frame');
            frame.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&enablejsapi=1`;
            Swal.fire({ title: 'STREAM READY', text: title, icon: 'info', timer: 1000, background: '#110F17', color: '#fff', showConfirmButton: false });
        }

        function loadCustomYouTubeVideo() {
            let input = document.getElementById('yt-custom-query').value.trim();
            if(!input) return;
            let videoId = input;
            if(input.includes('v=')) { videoId = input.split('v=')[1].split('&')[0]; }
            else if(input.includes('youtu.be/')) { videoId = input.split('youtu.be/')[1].split('?')[0]; }
            changeYouTubeVideo(videoId, `Video (${videoId})`);
        }

        // ----------------------------------------------------
        // 10. HERO AD SLIDESHOW
        // ----------------------------------------------------
        let currentAdIndex = 0;
        const adSlides = document.querySelectorAll('.ad-slide');
        const adDots = document.querySelectorAll('.ad-dot');

        function showAdSlide(index) {
            if(adSlides.length === 0) return;
            adSlides.forEach(s => s.classList.remove('active'));
            adDots.forEach(d => { d.className = "ad-dot w-1.5 h-1 rounded-full bg-white/20 transition-all"; });
            currentAdIndex = (index + adSlides.length) % adSlides.length;
            adSlides[currentAdIndex].classList.add('active');
            adDots[currentAdIndex].className = "ad-dot w-5 h-1 rounded-full bg-cyan-400 transition-all";
        }

        function nextAdSlide() { showAdSlide(currentAdIndex + 1); }
        function prevAdSlide() { showAdSlide(currentAdIndex - 1); }
        setInterval(nextAdSlide, 5500);

        // ----------------------------------------------------
        // 11. VIDEO PLAYER SUBSYSTEM
        // ----------------------------------------------------
        let videoPlayerInstance = null;
        let ccEnabled = false;
        let currentCCIndex = 0;
        let ccInterval = null;

        const dummySubtitles = [
            "Initializing Node Audio Bus...",
            "Resonance spatial frequency tuned.",
            "Approaching Next Expressway Interchange.",
            "Cabin acoustics dynamically optimized.",
            "Enjoy the Platinum Hybrid Node Experience."
        ];

        function initVideoEngine() {
            if(!videoPlayerInstance) {
                videoPlayerInstance = videojs('anix-video-element', {
                    controls: false, autoplay: false, preload: 'auto', fluid: false
                });

                videoPlayerInstance.on('timeupdate', () => {
                    const cur = videoPlayerInstance.currentTime();
                    const dur = videoPlayerInstance.duration() || 1;
                    document.getElementById('vp-cur-time').innerText = formatTime(cur);
                    document.getElementById('vp-dur-time').innerText = formatTime(dur);
                    document.getElementById('vp-seek-bar').value = (cur / dur) * 100;
                });

                videoPlayerInstance.on('play', () => { document.getElementById('vp-play-btn').innerHTML = '<i class="fas fa-pause text-xs"></i>'; });
                videoPlayerInstance.on('pause', () => { document.getElementById('vp-play-btn').innerHTML = '<i class="fas fa-play text-xs ml-0.5"></i>'; });
            }
        }

        function startVideoEngine(url, title, badge) {
            initVideoEngine();
            document.getElementById('vp-title').innerText = title;
            document.getElementById('vp-badge').innerText = badge;
            document.getElementById('video-container-root').classList.remove('hidden-page');
            document.getElementById('video-mini-pip').classList.add('hidden');
            
            videoPlayerInstance.src({ type: 'video/mp4', src: url });
