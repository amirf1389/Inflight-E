    <script>
        // ----------------------------------------------------
        // 1. PAGE NAVIGATION SYSTEM
        // ----------------------------------------------------
        function showPage(pageId) {
            document.querySelectorAll('.page-view').forEach(p => p.classList.add('hidden-page'));
            const target = document.getElementById(pageId);
            if(target) target.classList.remove('hidden-page');
            
            document.querySelectorAll('.nav-item').forEach(nav => {
                nav.classList.remove('active');
                if(nav.getAttribute('data-target') === pageId) nav.classList.add('active');
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ----------------------------------------------------
        // 2. ADMIN PIN LOCK SYSTEM
        // ----------------------------------------------------
        let isAdminUnlocked = false;
        function checkAdminAccess() {
            if (isAdminUnlocked) {
                showPage('admin-page');
                return;
            }
            Swal.fire({
                title: 'ADMIN SECURITY PIN',
                text: 'Enter Master Terminal Passcode (Default: 2026 or 7788)',
                input: 'password',
                inputAttributes: {
                    maxlength: 6,
                    autocapitalize: 'off',
                    autocorrect: 'off',
                    style: 'text-align:center; font-size: 24px; letter-spacing: 6px; font-family: monospace;'
                },
                showCancelButton: true,
                confirmButtonColor: '#6D28D9',
                cancelButtonColor: '#334155',
                confirmButtonText: 'Authorize Node',
                background: '#110F17',
                color: '#fff'
            }).then((result) => {
                if (result.isConfirmed) {
                    if (result.value === '2026' || result.value === '7788') {
                        isAdminUnlocked = true;
                        showPage('admin-page');
                        Swal.fire({
                            icon: 'success',
                            title: 'AUTHENTICATED',
                            text: 'Root terminal granted for Pod #04A session.',
                            timer: 1200,
                            showConfirmButton: false,
                            background: '#110F17',
                            color: '#fff'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'ACCESS DENIED',
                            text: 'Invalid Passcode entered.',
                            background: '#110F17',
                            color: '#fff'
                        });
                    }
                }
            });
        }

        function lockAdminSession() {
            isAdminUnlocked = false;
            showPage('main-dashboard');
            Swal.fire({ title: 'LOCKED', text: 'Admin terminal secured.', icon: 'info', timer: 1000, showConfirmButton: false, background: '#110F17', color: '#fff' });
        }

        // ----------------------------------------------------
        // 3. AUTO-BRIGHTNESS & SENSOR DETECTION
        // ----------------------------------------------------
        let autoBrightnessActive = true;
        function initAutoBrightnessSensor() {
            if ('AmbientLightSensor' in window) {
                try {
                    const sensor = new AmbientLightSensor();
                    sensor.addEventListener('reading', () => {
                        if (!autoBrightnessActive) return;
                        setBrightnessLevel(sensor.illuminance);
                    });
                    sensor.start();
                } catch (e) {
                    timeOfDayLuxFallback();
                }
            } else {
                timeOfDayLuxFallback();
            }
        }

        function timeOfDayLuxFallback() {
            const hr = new Date().getHours();
            let lux = 450;
            if (hr >= 19 || hr < 7) { lux = 40; } // Cabin dimmed at night
            setBrightnessLevel(lux);
        }

        function setBrightnessLevel(lux) {
            if (!autoBrightnessActive) return;
            const targetBrightness = Math.min(1.0, Math.max(0.45, 0.45 + (lux / 500) * 0.45));
            document.documentElement.style.setProperty('--wallpaper-brightness', targetBrightness.toFixed(2));
            const sensorEl = document.getElementById('lux-sensor-val');
            if (sensorEl) {
                sensorEl.innerText = `${Math.round(lux)} Lux (${Math.round(targetBrightness * 100)}%)`;
            }
        }

        function toggleAutoBrightness(enabled) {
            autoBrightnessActive = enabled;
            if (!enabled) {
                document.documentElement.style.setProperty('--wallpaper-brightness', '0.75');
                const sensorEl = document.getElementById('lux-sensor-val');
                if (sensorEl) sensorEl.innerText = 'Manual (75%)';
            } else {
                timeOfDayLuxFallback();
            }
        }
        setTimeout(initAutoBrightnessSensor, 600);

        // ----------------------------------------------------
        // 4. HOMEPAGE TRAILER PREVIEW MODAL
        // ----------------------------------------------------
        function openTrailerModal(videoUrl, title) {
            const modal = document.getElementById('trailer-modal');
            const video = document.getElementById('trailer-video-element');
            document.getElementById('trailer-title').innerText = title;
            video.src = videoUrl;
            modal.classList.remove('hidden-page');
            video.play().catch(() => {});
        }

        function closeTrailerModal() {
            const modal = document.getElementById('trailer-modal');
            const video = document.getElementById('trailer-video-element');
            video.pause();
            modal.classList.add('hidden-page');
        }

        // ----------------------------------------------------
        // 5. WEATHER MODAL CONTROLS
        // ----------------------------------------------------
        function openWeatherModal() { document.getElementById('weather-modal').classList.remove('hidden-page'); }
        function closeWeatherModal() { document.getElementById('weather-modal').classList.add('hidden-page'); }
        function refreshGeoWeather() {
            Swal.fire({ title: 'TELEMETRY SYNCED', text: 'Expressway weather radar updated.', icon: 'success', timer: 1000, background: '#110F17', color: '#fff', showConfirmButton: false });
        }

        // ----------------------------------------------------
        // 6. LOCAL PAYMENT GATEWAY & DIGITAL RECEIPTS
        // ----------------------------------------------------
        let currentPayMethod = "DuitNow QR";
        let currentPayAmount = 24.00;

        function setPaymentMethod(methodName) {
            currentPayMethod = methodName;
            document.getElementById('selected-gateway-label').innerText = methodName;
            document.querySelectorAll('.pay-method-btn').forEach(btn => {
                btn.className = "pay-method-btn p-3 rounded-xl bg-white/5 border border-white/10 text-slate-300 hover:bg-white/10 text-xs font-mono font-bold flex flex-col items-center gap-1.5";
            });
            event.currentTarget.className = "pay-method-btn active p-3 rounded-xl bg-emerald-600/30 border border-emerald-500/50 text-white text-xs font-mono font-bold flex flex-col items-center gap-1.5";
        }

        function executePaymentTransaction() {
            Swal.fire({
                title: 'PROCESSING PAYMENT',
                html: `<div class="font-mono text-xs text-slate-300">Connecting to ${currentPayMethod}...<br>Authenticating local bus gateway...</div>`,
                timer: 1400,
                showConfirmButton: false,
                background: '#110F17',
                color: '#fff'
            }).then(() => {
                const invNumber = 'INV-' + Math.floor(100000 + Math.random() * 900000);
                const now = new Date();
                const timeString = now.toLocaleDateString('en-GB') + ' ' + now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                
                document.getElementById('rcpt-no').innerText = invNumber;
                document.getElementById('rcpt-time').innerText = timeString;
                document.getElementById('rcpt-method').innerText = currentPayMethod;
                document.getElementById('rcpt-total').innerText = 'RM ' + currentPayAmount.toFixed(2);

                Swal.fire({
                    title: 'PAYMENT SUCCESSFUL',
                    text: `Transaction authorized. Invoice #${invNumber} generated.`,
                    icon: 'success',
                    background: '#110F17',
                    color: '#fff',
                    confirmButtonColor: '#10B981'
                });
            });
        }

