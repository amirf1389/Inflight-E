            const btn = document.getElementById('quick-dnd-btn');
            btn.innerText = dndActive ? "DND: ON" : "DND: OFF";
            btn.className = dndActive ? "px-2 py-0.5 rounded-md bg-red-600 text-[10px] font-mono font-bold text-white" : "px-2 py-0.5 rounded-md bg-white/10 text-[10px] font-mono font-medium text-slate-300";
        }
        function toggleLoungeMode() {
            const overlay = document.getElementById('lounge-overlay');
            overlay.style.opacity = '1';
            setTimeout(() => overlay.style.opacity = '0.3', 1500);
        }

        // ----------------------------------------------------
        // 17. SPEEDTEST
        // ----------------------------------------------------
        function runSpeedtest() {
            const btn = document.getElementById('speedtest-run-btn');
            const num = document.getElementById('speed-meter-num');
            const ping = document.getElementById('speed-ping');
            btn.disabled = true;
            btn.innerText = "TESTING...";
            let current = 20;
            const interval = setInterval(() => {
                current += Math.random() * 45;
                if(current >= 384.2) {
                    current = 384.2;
                    clearInterval(interval);
                    btn.disabled = false;
                    btn.innerText = "TEST SPEED";
                    ping.innerText = `${Math.floor(12 + Math.random() * 5)} ms`;
                }
                num.innerText = current.toFixed(1);
            }, 75);
        }

        // ----------------------------------------------------
        // 18. MUSIC PLAYER ENGINE
        // ----------------------------------------------------
        const musicCatalog = [
            { title: "Eclipsa Resonance Pulse", artist: "Platinum Audio Labs", url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3", cover: "https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=600&q=80" },
            { title: "Highway Synth Cruise", artist: "IAMF Sound Unit", url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3", cover: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=600&q=80" }
        ];

        let currentTrackIdx = 0;
        const audioElement = document.getElementById('anix-audio-node');

        function renderMusicCatalog() {
            const list = document.getElementById('music-track-list');
            if(!list) return;
            list.innerHTML = '';
            musicCatalog.forEach((track, idx) => {
                const item = document.createElement('div');
                item.className = "py-2.5 flex items-center justify-between group cursor-pointer";
                item.innerHTML = `
                    <div class="flex items-center gap-2.5" onclick="playMusicTrack(${idx})">
                        <div class="w-8 h-8 rounded-lg bg-purple-900/40 border border-purple-500/20 flex items-center justify-center text-purple-400 group-hover:bg-purple-600 group-hover:text-white transition-colors">
                            <i class="fas fa-play text-[10px]"></i>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-white group-hover:text-purple-300">${track.title}</div>
                            <div class="text-[10px] text-slate-400 font-mono">${track.artist}</div>
                        </div>
                    </div>
                    <span class="text-[10px] font-mono text-purple-400">3D IAMF</span>
                `;
                list.appendChild(item);
            });
        }
        renderMusicCatalog();

        audioElement.addEventListener('timeupdate', () => {
            const cur = audioElement.currentTime;
            const dur = audioElement.duration || 1;
            document.getElementById('music-cur-time').innerText = formatTime(cur);
            document.getElementById('music-dur-time').innerText = formatTime(dur);
            document.getElementById('music-seek-bar').value = (cur / dur) * 100;
        });

        function playMusicTrack(idx) {
            currentTrackIdx = idx;
            const track = musicCatalog[idx];
            audioElement.src = track.url;
            audioElement.play();

            document.getElementById('music-mini-title').innerText = track.title;
            document.getElementById('music-mini-artist').innerText = track.artist;
            document.getElementById('music-mini-cover').src = track.cover;
            document.getElementById('music-full-title').innerText = track.title;
            document.getElementById('music-full-artist').innerText = track.artist;
            document.getElementById('music-full-cover').src = track.cover;

            document.getElementById('music-mini-bar').classList.remove('hidden');
            setSpinning(true);
            updateMusicPlayIcons(true);
        }

        function toggleMusicPlay() {
            if(!audioElement.src) { playMusicTrack(0); return; }
            if(audioElement.paused) { audioElement.play(); setSpinning(true); updateMusicPlayIcons(true); }
            else { audioElement.pause(); setSpinning(false); updateMusicPlayIcons(false); }
        }

        function updateMusicPlayIcons(isPlaying) {
            document.getElementById('music-mini-play-btn').innerHTML = isPlaying ? '<i class="fas fa-pause text-xs"></i>' : '<i class="fas fa-play text-xs ml-0.5"></i>';
            document.getElementById('music-full-play-btn').innerHTML = isPlaying ? '<i class="fas fa-pause"></i>' : '<i class="fas fa-play ml-0.5"></i>';
        }

        function setSpinning(spin) {
            const disk1 = document.getElementById('mini-spin-disk');
            const disk2 = document.getElementById('music-full-disc');
            if(spin) { disk1.classList.remove('paused-disk'); disk2.classList.remove('paused-disk'); }
            else { disk1.classList.add('paused-disk'); disk2.classList.add('paused-disk'); }
        }

        function onMusicSeek(percent) {
            const dur = audioElement.duration;
            if(dur) audioElement.currentTime = (percent / 100) * dur;
        }

        function nextMusicTrack() { currentTrackIdx = (currentTrackIdx + 1) % musicCatalog.length; playMusicTrack(currentTrackIdx); }
        function prevMusicTrack() { currentTrackIdx = (currentTrackIdx - 1 + musicCatalog.length) % musicCatalog.length; playMusicTrack(currentTrackIdx); }
        function openMusicFullPlayer() { document.getElementById('music-full-modal').classList.remove('hidden-page'); }
        function closeMusicFullPlayer() { document.getElementById('music-full-modal').classList.add('hidden-page'); }
        function closeMusicMiniPlayer() { audioElement.pause(); document.getElementById('music-mini-bar').classList.add('hidden'); setSpinning(false); }
        function toggleMusicShuffle() { document.getElementById('music-shuffle-btn').classList.toggle('text-purple-400'); }
        function toggleMusicRepeat() { document.getElementById('music-repeat-btn').classList.toggle('text-purple-400'); }

        function formatTime(secs) {
            const m = Math.floor(secs / 60);
            const s = Math.floor(secs % 60);
            return `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
        }

        // ----------------------------------------------------
        // 19. ROTARY VOLUME KNOB
        // ----------------------------------------------------
        const volKnob = document.getElementById('volume-knob');
        const volIndicator = document.getElementById('volume-indicator');
        const volText = document.getElementById('volume-text');
        const volRing = document.getElementById('volume-ring');
        let isDraggingVol = false;
        let startY = 0;
        let currentVolume = 50;

        function setVolume(pct) {
            pct = Math.max(0, Math.min(100, pct));
            currentVolume = pct;
            const angle = -135 + (pct / 100) * 270;
            volIndicator.style.transform = `rotate(${angle}deg)`;
            volText.innerText = `${Math.round(pct)}%`;
            volRing.style.strokeDashoffset = 264 - (198 * (pct / 100));
            if(videoPlayerInstance) videoPlayerInstance.volume(pct / 100);
            if(audioElement) audioElement.volume = pct / 100;
        }

        function startDrag(y) { isDraggingVol = true; startY = y; volKnob.classList.add('scale-95'); }
        function handleDrag(y) {
            if(!isDraggingVol) return;
            const deltaY = startY - y;
            setVolume(currentVolume + deltaY * 0.7);
            startY = y;
        }
        function stopDrag() { isDraggingVol = false; volKnob.classList.remove('scale-95'); }

        volKnob.addEventListener('mousedown', (e) => startDrag(e.clientY));
        document.addEventListener('mousemove', (e) => handleDrag(e.clientY));
        document.addEventListener('mouseup', stopDrag);
        volKnob.addEventListener('touchstart', (e) => startDrag(e.touches[0].clientY), {passive: true});
        document.addEventListener('touchmove', (e) => handleDrag(e.touches[0].clientY), {passive: true});
        document.addEventListener('touchend', stopDrag);
        setVolume(50);

        // ----------------------------------------------------
        // 20. THREE.JS & AMBIENT CANVAS
        // ----------------------------------------------------
        function initThreeJS() {
            const container = document.getElementById('threejs-canvas-container');
            if(!container) return;
            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(75, container.clientWidth / container.clientHeight, 0.1, 1000);
            const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            container.appendChild(renderer.domElement);
            const geometry = new THREE.IcosahedronGeometry(1, 1);
            const material = new THREE.MeshBasicMaterial({ color: 0x00F0FF, wireframe: true, transparent: true, opacity: 0.35 });
            const sphere = new THREE.Mesh(geometry, material);
            scene.add(sphere);
            camera.position.z = 2.5;
            function animate() {
                requestAnimationFrame(animate);
                sphere.rotation.x += 0.004;
                sphere.rotation.y += 0.008;
                renderer.render(scene, camera);
            }
            animate();
        }
        setTimeout(initThreeJS, 250);

        const canvas = document.getElementById('bg-ambient-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];
        function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class AmbientParticle {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2 + 0.5;
                this.speedX = (Math.random() - 0.5) * 0.25;
                this.speedY = (Math.random() - 0.5) * 0.25;
                const hues = [0, 260, 280, 200];
                this.hue = hues[Math.floor(Math.random() * hues.length)];
            }
            update() {
                this.x += this.speedX; this.y += this.speedY;
                if(this.x > canvas.width) this.x = 0; if(this.x < 0) this.x = canvas.width;
                if(this.y > canvas.height) this.y = 0; if(this.y < 0) this.y = canvas.height;
            }
            draw() {
                ctx.fillStyle = `hsla(${this.hue}, 80%, 60%, 0.25)`;
                ctx.beginPath(); ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2); ctx.fill();
            }
        }
        for(let i = 0; i < 35; i++) particles.push(new AmbientParticle());
        function animateBg() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => { p.update(); p.draw(); });
            requestAnimationFrame(animateBg);
        }
        animateBg();

        // ----------------------------------------------------
        // 21. WALLPAPER & ACCESSIBILITY
        // ----------------------------------------------------
        function applyWallpaper(url, name) {
            document.documentElement.style.setProperty('--wallpaper-image', `url('${url}')`);
            Swal.fire({ title: 'THEME APPLIED', text: name, icon: 'success', timer: 1000, background: '#110F17', color: '#fff', showConfirmButton: false });
        }
        function resetDefaultWallpaper() {
            applyWallpaper('https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=1920&auto=format&fit=crop', 'Cyber Neon Horizon');
        }
        function toggleAccessibilityModal() {
            document.body.classList.toggle('a11y-high-contrast');
        }
        function triggerSOS() {
            Swal.fire({ title: 'SOS TRANSMITTED', text: 'Emergency telemetry beacon dispatched to highway control.', icon: 'warning', background: '#110F17', color: '#fff' });
        }
        function clearAdminTerminal() {
            document.getElementById('ota-terminal').innerHTML = '<div>[SYS] Socket buffer cleared. Ready.</div>';
        }
    </script>
</body>
