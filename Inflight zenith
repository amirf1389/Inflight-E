        ];

        function handleFolderIngest(event) {
            const files = event.target.files;
            if(!files || files.length === 0) return;
            let ingestedCount = 0;
            let rootFolderName = "";

            for (let i = 0; i < files.length; i++) {
                const f = files[i];
                const isVideo = f.type.startsWith('video') || f.name.match(/\.(mp4|mkv|webm|mov|avi)$/i);
                const isAudio = f.type.startsWith('audio') || f.name.match(/\.(mp3|flac|wav|aac|ogg)$/i);

                if(isVideo || isAudio) {
                    const relativePath = f.webkitRelativePath || f.name;
                    const pathParts = relativePath.split('/');
                    if(!rootFolderName && pathParts.length > 1) { rootFolderName = pathParts[0]; }
                    const folderPath = pathParts.length > 1 ? '/' + pathParts.slice(0, -1).join('/') : '/Root';
                    const objectUrl = URL.createObjectURL(f);
                    const sizeMB = (f.size / (1024 * 1024)).toFixed(1) + ' MB';

                    localIngestDB.unshift({
                        id: Date.now() + i,
                        name: f.name,
                        folder: folderPath,
                        type: isVideo ? "Video (Local)" : "Audio (Local)",
                        size: sizeMB,
                        path: relativePath,
                        blobUrl: objectUrl,
                        status: "Mounted"
                    });
                    ingestedCount++;
                }
            }
            renderIngestDBTable();
            Swal.fire({ title: 'FOLDER INGESTED', text: `${ingestedCount} media files mounted to vault.`, icon: 'success', background: '#110F17', color: '#fff', confirmButtonColor: '#00F0FF' });
        }

